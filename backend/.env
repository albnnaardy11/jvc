# Konfigurasi Supabase PostgreSQL
# Format dari Supabase biasanya: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# PENTING: Karena kita memakai 'asyncpg', ubah tulisan 'postgresql://' menjadi 'postgresql+asyncpg://'

POSTGRES_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Konfigurasi Tambahan Nanti
# SECRET_KEY=your-super-secret-key
